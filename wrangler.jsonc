{
  "name": "myportfolio",
  "compatibility_date": "2026-10-11",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/data/content.json"
    ]
  },
  "main": "worker/index.js"
}
